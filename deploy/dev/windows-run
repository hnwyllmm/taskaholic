#!/data/wangyunlai.wyl/vm/win11/config/winrm-client-venv/bin/python
"""Host-only WinRM transport. Reuse protected host credentials; stream stdin.

Large approved source snapshots must not pass through Windows' command line.
This is a runtime entry point, not a tool exposed to sandboxed agents.
"""
import base64
import argparse
import hashlib
import ipaddress
import json
import os
from pathlib import Path
import runpy
import stat
import sys
import time

host = runpy.run_path('/data/wangyunlai.wyl/vm/win11/config/winrm-run')
WinRMOperationTimeoutError = host['winrm'].exceptions.WinRMOperationTimeoutError

MAX_COMMAND_OUTPUT = 8 * 1024 * 1024
OUTPUT_LIMIT_EXIT = 74

def discover_address():
    # This dev-specific entry point pins the verified win11 NIC identity.
    # Root-owned dnsmasq leases are readable without sudo or setuid privileges.
    leases = Path('/var/lib/libvirt/dnsmasq/virbr0.status')
    info = leases.lstat()
    if info.st_uid != 0 or not stat.S_ISREG(info.st_mode) or info.st_mode & 0o022:
        raise RuntimeError('Untrusted libvirt lease file')
    matches = [item for item in json.loads(leases.read_text())
        if item.get('mac-address', '').lower() == '52:54:00:11:25:11'
        and item.get('expiry-time', 0) > time.time()]
    if len(matches) != 1:
        raise RuntimeError('No unique active lease for the configured win11 NIC')
    address = ipaddress.ip_address(matches[0]['ip-address'])
    if address not in ipaddress.ip_network('192.168.122.0/24'):
        raise RuntimeError('Windows lease is outside the configured VM network')
    return str(address)


def receive_command_output(protocol, shell, command):
    """Drain WinRM incrementally and stop runaway console output."""
    total = 0
    while True:
        try:
            out, err, code, done = protocol.get_command_output_raw(shell, command)
        except WinRMOperationTimeoutError:
            continue
        for payload, stream in ((out, sys.stdout.buffer), (err, sys.stderr.buffer)):
            if not payload:
                continue
            remaining = max(0, MAX_COMMAND_OUTPUT - total)
            if remaining:
                stream.write(payload[:remaining])
                stream.flush()
            total += len(payload)
            if total > MAX_COMMAND_OUTPUT:
                sys.stderr.write(
                    '\n[work-assistant: Windows command output exceeded 8 MiB; '
                    'the command was stopped. Redirect large output to a file '
                    'and inspect a focused excerpt.]\n'
                )
                sys.stderr.flush()
                protocol.cleanup_command(shell, command)
                return OUTPUT_LIMIT_EXIT, True
        if done:
            return code, False

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--upload')
    parser.add_argument('--destination')
    args = parser.parse_args()
    if bool(args.upload) != bool(args.destination):
        parser.error('--upload and --destination must be supplied together')
    script = b'' if args.upload else sys.stdin.buffer.read()
    username, password = host['read_credentials']()
    address = discover_address()
    # This transport is only for the local VM, never the model's HTTP proxy.
    for name in ('HTTP_PROXY','HTTPS_PROXY','ALL_PROXY','http_proxy','https_proxy','all_proxy'):
        os.environ.pop(name, None)
    os.environ['NO_PROXY'] = os.environ['no_proxy'] = '*'
    session = host['winrm'].Session(
        f'http://{address}:5985/wsman', auth=(username, password),
        transport='ntlm', operation_timeout_sec=60, read_timeout_sec=70)
    protocol = session.protocol
    # A short fixed bootstrap reads base64 UTF-8 from stdin, not PowerShell source lines.
    bootstrap = '[Console]::OutputEncoding=[Text.Encoding]::UTF8; & ([scriptblock]::Create([Text.Encoding]::UTF8.GetString([Convert]::FromBase64String([Console]::In.ReadToEnd()))))'
    if args.upload:
        expected_hash = hashlib.sha256()
        with open(args.upload, 'rb') as source:
            while chunk := source.read(1024 * 1024):
                expected_hash.update(chunk)
        destination = base64.b64encode(args.destination.encode('utf-8')).decode('ascii')
        bootstrap = """
$ErrorActionPreference='Stop'
$destination=[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('__DEST__'))
$destination=[IO.Path]::GetFullPath($destination)
$parent=Split-Path $destination -Parent
New-Item -ItemType Directory -Path $parent -Force | Out-Null
$tmp=$destination+'.upload-'+[guid]::NewGuid().ToString('N')
$stream=[IO.File]::Open($tmp,[IO.FileMode]::CreateNew,[IO.FileAccess]::Write,[IO.FileShare]::None)
try {
 while($null -ne ($line=[Console]::In.ReadLine())){
  $data=[Convert]::FromBase64String($line)
  $stream.Write($data,0,$data.Length)
 }
 $stream.Flush($true)
}finally{$stream.Dispose()}
$hash=(Get-FileHash -LiteralPath $tmp -Algorithm SHA256).Hash.ToLowerInvariant()
if($hash -ne '__HASH__'){throw 'Upload checksum mismatch; destination not replaced'}
Move-Item -LiteralPath $tmp -Destination $destination -Force
Write-Output ('UPLOAD_SHA256='+$hash)
""".replace('__DEST__', destination).replace('__HASH__', expected_hash.hexdigest())
    encoded = base64.b64encode(bootstrap.encode('utf-16-le')).decode('ascii')
    shell = protocol.open_shell()
    command = None
    try:
        command = protocol.run_command(shell, 'powershell.exe',
            ['-NoLogo', '-NoProfile', '-NonInteractive', '-EncodedCommand', encoded],
            console_mode_stdin=False)
        digest = hashlib.sha256()
        if args.upload:
            with open(args.upload, 'rb') as data:
                while chunk := data.read(49152):
                    digest.update(chunk)
                    protocol.send_command_input(shell, command, base64.b64encode(chunk)+b'\n')
        else:
            payload = base64.b64encode(script)
            for offset in range(0, len(payload), 98304):
                protocol.send_command_input(shell, command, payload[offset:offset+98304])
        protocol.send_command_input(shell, command, b'', end=True)
        terminated = False
        if args.upload:
            out, err, code = protocol.get_command_output(shell, command)
        else:
            code, terminated = receive_command_output(protocol, shell, command)
            out, err = b'', b''
        if args.upload and code == 0:
            expected = ('UPLOAD_SHA256='+digest.hexdigest()).encode()
            if expected not in out:
                raise RuntimeError('Uploaded file checksum did not match')
        sys.stdout.buffer.write(out)
        # A script can catch an error and emit a failed business result while
        # PowerShell exits zero. Its stderr is still essential diagnostic data.
        sys.stderr.buffer.write(err)
        if terminated:
            command = None
        return code
    finally:
        try:
            if command is not None:
                protocol.cleanup_command(shell, command)
        finally:
            protocol.close_shell(shell)

if __name__ == '__main__':
    sys.exit(main())
